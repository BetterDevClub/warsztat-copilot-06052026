<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- dotnet restore currently fails on NU1902 (audit) with TreatWarningsAsErrors=true. -->
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" />
    <PackageReference Include="MudBlazor" />
    <ProjectReference Include="..\BookSlot.Web.Client\BookSlot.Web.Client.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BookSlot.Infrastructure\BookSlot.Infrastructure.csproj" />
    <ProjectReference Include="..\BookSlot.Features\BookSlot.Features.csproj" />
  </ItemGroup>

</Project>
