@using Microsoft.AspNetCore.Components.Authorization
@using BookSlot.Web.Client.Pages
@using MudBlazor

<CascadingAuthenticationState>
    <Router AppAssembly="typeof(BookSlot.Web.Components.App).Assembly"
            AdditionalAssemblies="new[] { typeof(BookSlot.Web.Client._Imports).Assembly }">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(BookSlot.Web.Client.Layout.MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity is not { IsAuthenticated: true })
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <MudContainer MaxWidth="MaxWidth.Small" Class="mt-10">
                            <MudAlert Severity="Severity.Warning">You do not have permission to view this page.</MudAlert>
                        </MudContainer>
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="typeof(BookSlot.Web.Client.Layout.MainLayout)">
                <MudContainer MaxWidth="MaxWidth.Small" Class="mt-10">
                    <MudText Typo="Typo.h4">Not Found</MudText>
                    <MudText>Sorry, the content you are looking for does not exist.</MudText>
                </MudContainer>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
