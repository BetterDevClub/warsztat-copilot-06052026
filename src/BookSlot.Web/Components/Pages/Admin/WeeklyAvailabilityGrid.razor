@using BookSlot.Features.Staff.SetAvailabilityRules

@* Visual weekly grid editor. Click/drag cells to toggle 30-min slots on/off per weekday. *@

<MudPaper Class="pa-3" Outlined="true">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
        <MudText Typo="Typo.body2" Color="Color.Secondary">Click cells to toggle 30-min blocks. Click and drag to paint. Contiguous blocks are merged into rules automatically.</MudText>
        <MudSpacer />
        <MudButton Size="Size.Small" OnClick="ClearAll">Clear all</MudButton>
        <MudButton Size="Size.Small" OnClick="FillBusinessHours">9–17 Mon–Fri</MudButton>
    </MudStack>
    <div class="avail-grid" @onmouseup="StopPaint" @onmouseleave="StopPaint">
        <div class="avail-row avail-head">
            <div class="avail-time-col"></div>
            @for (var d = 0; d < 7; d++)
            {
                var day = d;
                <div class="avail-day-head">@DayLabel(day)</div>
            }
        </div>
        @for (var slot = StartSlot; slot < EndSlot; slot++)
        {
            var s = slot;
            <div class="avail-row">
                <div class="avail-time-col">
                    @if (s % 2 == 0) { @FormatTime(s) }
                </div>
                @for (var d = 0; d < 7; d++)
                {
                    var day = d;
                    var on = _cells[day, s];
                    <div class="avail-cell @(on ? "avail-on" : "")"
                         @onmousedown="@(() => StartPaint(day, s))"
                         @onmouseenter="@(() => PaintIfDragging(day, s))">
                    </div>
                }
            </div>
        }
    </div>
</MudPaper>

<style>
    .avail-grid { user-select: none; border: 1px solid var(--mud-palette-lines-default); border-radius: 4px; overflow: hidden; }
    .avail-row { display: grid; grid-template-columns: 56px repeat(7, 1fr); }
    .avail-head { background: var(--mud-palette-background-grey); font-weight: 600; }
    .avail-day-head { padding: 4px 6px; border-left: 1px solid var(--mud-palette-lines-default); text-align: center; font-size: 12px; }
    .avail-time-col { padding: 2px 6px; font-size: 11px; color: var(--mud-palette-text-secondary); border-top: 1px dashed transparent; text-align: right; }
    .avail-cell { height: 16px; border-left: 1px solid var(--mud-palette-lines-default); border-top: 1px dashed rgba(0,0,0,0.06); cursor: pointer; background: var(--mud-palette-background); }
    .avail-cell.avail-on { background: var(--mud-palette-primary); opacity: 0.85; }
    .avail-cell:hover { filter: brightness(0.95); }
</style>

@code {
    /// <summary>Initial rules to seed the grid.</summary>
    [Parameter] public IReadOnlyList<SetAvailabilityRules.RuleDto> InitialRules { get; set; } = Array.Empty<SetAvailabilityRules.RuleDto>();

    /// <summary>Invoked on every change with the derived, merged rule list.</summary>
    [Parameter] public EventCallback<IReadOnlyList<SetAvailabilityRules.RuleDto>> OnChanged { get; set; }

    // Grid window: 06:00 → 22:00 at 30-min slots = 32 slots
    private const int StartSlot = 12; // 06:00
    private const int EndSlot = 44;   // 22:00
    private const int TotalSlots = 48; // 00:00..23:30

    // [day (0=Mon..6=Sun), slot 0..47]
    private bool[,] _cells = new bool[7, 48];
    private bool _dragging;
    private bool _paintValue;

    protected override void OnParametersSet()
    {
        Array.Clear(_cells);
        foreach (var r in InitialRules)
        {
            var day = MondayFirst(r.DayOfWeek);
            var startSlot = r.StartTime.Hour * 2 + (r.StartTime.Minute >= 30 ? 1 : 0);
            var endSlot = r.EndTime.Hour * 2 + (r.EndTime.Minute >= 30 ? 1 : 0);
            if (r.EndTime == new TimeOnly(0, 0)) endSlot = TotalSlots;
            for (var s = startSlot; s < endSlot && s < TotalSlots; s++) _cells[day, s] = true;
        }
    }

    private void StartPaint(int day, int slot)
    {
        _dragging = true;
        _paintValue = !_cells[day, slot];
        _cells[day, slot] = _paintValue;
        Emit();
    }

    private void PaintIfDragging(int day, int slot)
    {
        if (!_dragging) return;
        _cells[day, slot] = _paintValue;
        Emit();
    }

    private void StopPaint() => _dragging = false;

    private void ClearAll()
    {
        Array.Clear(_cells);
        Emit();
    }

    private void FillBusinessHours()
    {
        Array.Clear(_cells);
        // Mon..Fri 09:00-17:00 → slots 18..34
        for (var d = 0; d < 5; d++)
            for (var s = 18; s < 34; s++) _cells[d, s] = true;
        Emit();
    }

    private void Emit()
    {
        var rules = DeriveRules();
        StateHasChanged();
        OnChanged.InvokeAsync(rules);
    }

    private IReadOnlyList<SetAvailabilityRules.RuleDto> DeriveRules()
    {
        var list = new List<SetAvailabilityRules.RuleDto>();
        for (var d = 0; d < 7; d++)
        {
            int? runStart = null;
            for (var s = 0; s <= TotalSlots; s++)
            {
                var on = s < TotalSlots && _cells[d, s];
                if (on && runStart is null) runStart = s;
                else if (!on && runStart is not null)
                {
                    list.Add(new SetAvailabilityRules.RuleDto(
                        FromMondayFirst(d),
                        SlotToTime(runStart.Value),
                        SlotToTime(s)));
                    runStart = null;
                }
            }
        }
        return list;
    }

    private static TimeOnly SlotToTime(int slot)
    {
        if (slot >= TotalSlots) return new TimeOnly(23, 59);
        return new TimeOnly(slot / 2, (slot % 2) * 30);
    }

    private static int MondayFirst(DayOfWeek d) => ((int)d + 6) % 7;
    private static DayOfWeek FromMondayFirst(int d) => (DayOfWeek)((d + 1) % 7);
    private static string DayLabel(int d) => d switch { 0 => "Mon", 1 => "Tue", 2 => "Wed", 3 => "Thu", 4 => "Fri", 5 => "Sat", _ => "Sun" };
    private static string FormatTime(int slot) => $"{slot / 2:00}:{(slot % 2) * 30:00}";
}
