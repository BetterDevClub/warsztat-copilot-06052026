@using BookSlot.Features.Staff.Create

<MudDialog>
    <DialogContent>
        <MudStack>
            <MudTextField @bind-Value="_displayName" Label="Display name" Required="true" MaxLength="120" />
            <MudTextField @bind-Value="_title" Label="Title (optional)" MaxLength="80" />
            <MudTextField @bind-Value="_email" Label="Email (optional)" InputType="InputType.Email" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(string.IsNullOrWhiteSpace(_displayName))">Create</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Mud { get; set; } = null!;
    private string _displayName = string.Empty;
    private string? _title;
    private string? _email;

    private void Cancel() => Mud.Cancel();
    private void Submit() => Mud.Close(DialogResult.Ok(new CreateStaff.Command(_displayName.Trim(), string.IsNullOrWhiteSpace(_title) ? null : _title!.Trim(), string.IsNullOrWhiteSpace(_email) ? null : _email!.Trim())));
}
