@namespace BookSlot.Web.Components.Pages.Admin
@using BookSlot.Features.ServiceTypes.Create

<MudDialog>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_name" Label="Name" Required="true" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_slug" Label="Slug (url-safe)" Required="true" /></MudItem>
            <MudItem xs="6" sm="3"><MudNumericField @bind-Value="_duration" Label="Duration (min)" Min="5" Max="1440" /></MudItem>
            <MudItem xs="6" sm="3"><MudNumericField @bind-Value="_bufferBefore" Label="Buffer before" Min="0" Max="240" /></MudItem>
            <MudItem xs="6" sm="3"><MudNumericField @bind-Value="_bufferAfter" Label="Buffer after" Min="0" Max="240" /></MudItem>
            <MudItem xs="6" sm="3"><MudNumericField @bind-Value="_price" Label="Price" Min="0" /></MudItem>
            <MudItem xs="6" sm="3"><MudTextField @bind-Value="_currency" Label="Currency" MaxLength="3" /></MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="_description" Label="Description" Lines="3" /></MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Ok">Create</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private string _name = string.Empty;
    private string _slug = string.Empty;
    private int _duration = 60;
    private int _bufferBefore;
    private int _bufferAfter;
    private decimal _price;
    private string _currency = "PLN";
    private string? _description;

    private void Ok() => MudDialog.Close(DialogResult.Ok(new CreateServiceType.Command(
        _name, _slug, _duration, _bufferBefore, _bufferAfter, _price, _currency, _description)));
    private void Cancel() => MudDialog.Cancel();
}
